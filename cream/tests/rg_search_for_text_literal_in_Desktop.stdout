()\n    45\t        if category not in categories:\n    46\t            raise ValueError(\n    47\t                f\"Invalid category. Must be one of: {', '.join(categories)}\"\n    48\t            )\n    49\t\n    50\t        # Parse date to validate format\n    51\t        try:\n    52\t            datetime.strptime(date, \"%Y-%m-%d\")\n    53\t        except ValueError:\n    54\t            raise ValueError(\"Date must be in YYYY-MM-DD format\")\n    55\t\n    56\t        # Add to CSV file\n    57\t        file_exists = self.data_file.exists()\n    58\t        with open(self.data_file, \"a\", newline=\"\") as f:\n    59\t            writer = csv.writer(f)\n    60\t            if not file_exists:\n    61\t                writer.writerow([\"date\", \"amount\", \"category\", \"description\"])\n    62\t            writer.writerow([date, amount, category, description])\n    63\t\n    64\t    def get_expenses(\n    65\t        self,\n    66\t        start_date: str | None = None,\n    67\t        end_date: str | None = None,\n    68\t        category: str | None = None,\n    69\t    ) -> list[dict[str, Any]]:\n    70\t        \"\"\"Get expenses with optional filtering\"\"\"\n    71\t        expenses = []\n    72\t\n    73\t        try:\n    74\t            with open(self.data_file) as f:\n    75\t                reader = csv.DictReader(f)\n    76\t                for row in reader:\n    77\t                    # Convert amount to float\n    78\t                    row[\"amount\"] = float(row[\"amount\"])\n    79\t\n    80\t                    # Apply filters\n    81\t                    if start_date and row[\"date\"] < start_date:\n    82\t                        continue\n    83\t                    if end_date and row[\"date\"] > end_date:\n    84\t                        continue\n    85\t                    if category and row[\"category\"] != category:\n    86\t                        continue\n    87\t\n    88\t                    expenses.append(row)\n    89\t        except FileNotFoundError:\n    90\t            return []\n    91\t\n    92\t        return expenses\n    93\t\n    94\t    def get_total_expenses(\n    95\t        self, start_date: str | None = None, end_date: str | None = None\n    96\t    ) -> float:\n    97\t        \"\"\"Get total amount of expenses in date range\"\"\"\n    98\t        expenses = self.get_expenses(start_date, end_date)\n    99\t        return sum(expense[\"amount\"] for expense in expenses)\n   100\t\n   101\t    def get_expenses_by_category(\n   102\t        self, start_date: str | None = None, end_date: str | None = None\n   103\t    ) -> dict[str, float]:\n   104\t        \"\"\"Get expenses grouped by category\"\"\"\n   105\t        expenses = self.get_expenses(start_date, end_date)\n   106\t        category_totals = {}\n   107\t\n   108\t        for expense in expenses:\n   109\t            category = expense[\"category\"]\n   110\t            amount = expense[\"amount\"]\n   111\t            category_totals[category] = category_totals.get(category, 0) + amount\n   112\t\n   113\t        return category_totals\n   114\t\n   115\t\n   116\tif __name__ == \"__main__\":\n   117\t    # Simple test\n   118\t    tracker = ExpenseTracker()\n   119\t    print(\"Expense tracker initialized successfully\")\n   120\t    print(f\"Available categories: {tracker.get_categories()}\")\n   121\t\n",
